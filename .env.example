# Provider credentials and endpoints. Model names are configured in the website UI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1

# Connect a public Vercel Blob store to the project; Vercel sets this automatically.
BLOB_READ_WRITE_TOKEN=

# Dedicated Private Vercel Blob store for uploaded image/DXF/AI source files.
# Create a second Blob store in Private mode and use a custom environment
# variable prefix so it does not replace the public store above.
MATERIAL_BLOB_READ_WRITE_TOKEN=
MATERIAL_LIBRARY_TOKEN=

# PostgreSQL connection string from Neon, Supabase, or another Vercel integration.
DATABASE_URL=

# Optional local fallback directory. When the two variables above are empty,
# sessions use SQLite and files are stored here (default: ./var).
LOCAL_DATA_DIR=

# Initial administrator. These values are read only when the account table is empty.
# The login page never offers self-registration; further accounts are created by an admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=系统管理员

# Set to true for HTTPS deployments outside Vercel. Vercel enables secure cookies automatically.
AUTH_SECURE_COOKIE=

# Usage is priced as tokens x unit rate. The rates below default to the official
# price list (https://platform.openai.com/docs/pricing) for every model this app
# calls, so they only need to be set when a provider changes its prices.
# Cost = (text input tokens * text rate + image input tokens * image rate
#         + cached input tokens * cached rate + output tokens * output rate) / 1,000,000
# An empty value keeps the official rate; a number overrides it.
# GPT Image family (gpt-image-2.5-flare / gpt-image-2.5-sunburst):
USAGE_PRICE_IMAGE_TEXT_INPUT_PER_MILLION=
USAGE_PRICE_IMAGE_INPUT_PER_MILLION=
USAGE_PRICE_IMAGE_OUTPUT_PER_MILLION=
# Cached input tokens (Responses API) for every model.
USAGE_PRICE_CACHED_INPUT_PER_MILLION=
# Text and vision models (gpt-6-luna and friends).
USAGE_PRICE_VISION_INPUT_PER_MILLION=
USAGE_PRICE_VISION_OUTPUT_PER_MILLION=

# Flat fallback prices (USD) used only when a call reports no tokens at all,
# for example the Hunyuan 3D task that is billed per model.
USAGE_PRICE_IMAGE_PER_IMAGE=0.14
USAGE_PRICE_3D_PER_TASK=0.5
# Amount reserved for a call whose model has no rate, before its tokens are known.
USAGE_RESERVE_VISION_PER_CALL_USD=0.10
