# Provider credentials and endpoints. Model names are configured in the website UI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1

# Connect a public Vercel Blob store to the project; Vercel sets this automatically.
BLOB_READ_WRITE_TOKEN=

# PostgreSQL connection string from Neon, Supabase, or another Vercel integration.
DATABASE_URL=

# Optional local fallback directory. When the two variables above are empty,
# sessions use SQLite and files are stored here (default: ./var).
LOCAL_DATA_DIR=

# Initial administrator. These values are read only when the account table is empty.
# The login page never offers self-registration; further accounts are created by an admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=系统管理员

# Set to true for HTTPS deployments outside Vercel. Vercel enables secure cookies automatically.
AUTH_SECURE_COOKIE=
