# Runtime configuration: application code intentionally has no model or endpoint defaults.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium

HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_3D_MODEL=hy-3d-3.1

# Connect a public Vercel Blob store to the project; Vercel sets this automatically.
BLOB_READ_WRITE_TOKEN=

# PostgreSQL connection string from Neon, Supabase, or another Vercel integration.
DATABASE_URL=

# Optional local fallback directory. When the two variables above are empty,
# sessions use SQLite and files are stored here (default: ./var).
LOCAL_DATA_DIR=
